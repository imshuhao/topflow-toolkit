+// 三卡状态辅助函数（null / 缺字段统一显示 -）
+function modemState(card: ModemCardView): string {
+  if (card.state) return card.state;
+  if (card.present === false) return 'absent';
+  if (card.online === true) return 'connected';
+  if (card.enabled === false) return 'disabled';
+  return 'unknown';
+}
+
+function modemOnline(card: ModemCardView): boolean {
+  return modemState(card) === 'connected';
+}
+
+function modemStatus(card: ModemCardView): { text: string; cls: string } {
+  switch (modemState(card)) {
+    case 'connected':
+      return { text: '在线', cls: 'success' };
+    case 'disabled':
+      return { text: '已停用', cls: 'muted' };
+    case 'offline':
+      return { text: '未连接', cls: 'warning' };
+    case 'absent':
+      return { text: '未检测到', cls: 'danger' };
+    default:
+      return { text: '未知', cls: 'muted' };
+  }
+}
+
+function modemNum(v: number | null | undefined): number | null {
+  return typeof v === 'number' && !Number.isNaN(v) ? v : null;
+}
+
