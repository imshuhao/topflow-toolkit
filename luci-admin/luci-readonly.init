#!/bin/sh /etc/rc.common
# OpenWrt rc.common consumes these declarations.
# shellcheck disable=SC2034
START=99
# shellcheck disable=SC2034
STOP=01
# shellcheck disable=SC2034
USE_PROCD=1
BASE=/data/local/luci-readonly
start_service() {
    [ -f "$BASE/enabled" ] || return 1
    procd_open_instance
    procd_set_param command "$BASE/stage/usr/bin/unshare" -m "$BASE/run-namespace.sh"
    procd_set_param respawn 3600 5 5
    procd_set_param term_timeout 15
    procd_close_instance
}
